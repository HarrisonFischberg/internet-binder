node_modules/
.DS_Store
# Screenshot rounds (UI tests, /impeccable): keep them in the project files folder, not in git.
# The ones committed before 2.2.4 are still in history (git checkout 6656c47 -- replica/m3/screens).
replica/m3/screens/
impeccable-review/before/
impeccable-review/after/
impeccable-review/img/

# QA credentials (tools/qa): the real file stays local; .env.qa.example is the template.
.env.qa.local
.env*.local
# QA run output (reports, raw provider answers) stays out of git.
tools/qa/out/
# Release output (./release.sh, fastlane). fastlane rewrites its own README; the real one is release/README.md.
build/
fastlane/report.xml
fastlane/README.md
fastlane/test_output/
*.p8
# Store releases: build output and secrets never go in git (release/README.md)
# Raw simulator shots; only the framed ones in store/ios/screenshots are committed.
store/ios/raw/
*.ipa
*.dSYM.zip
# App Review phone number: kept out of git on purpose (release/README.md).
store/ios/metadata/review_information/phone_number.txt
store/mac/metadata/review_information/phone_number.txt

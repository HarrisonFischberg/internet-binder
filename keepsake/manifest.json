{
  "manifest_version": 3,
  "name": "Internet Binder",
  "version": "2.2.2",
  "description": "Save products, places, recipes, videos and more from any site. Sorted for you, kept on your device. No account.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/styles/pantry/icon16.png",
    "32": "icons/styles/pantry/icon32.png",
    "48": "icons/styles/pantry/icon48.png",
    "128": "icons/styles/pantry/icon128.png"
  },
  "action": {
    "default_title": "Save to Internet Binder",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/styles/pantry/icon16.png",
      "32": "icons/styles/pantry/icon32.png",
      "48": "icons/styles/pantry/icon48.png",
      "128": "icons/styles/pantry/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "src/dashboard/dashboard.html",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open Internet Binder for the current page"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: http: data: blob:; connect-src 'self' https:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}

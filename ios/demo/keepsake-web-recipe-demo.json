 "items": {
  "5a1f0c3e-7b2d-4c8e-9f41-2e6b8d0a7c11": {
   "id": "5a1f0c3e-7b2d-4c8e-9f41-2e6b8d0a7c11",
   "collectionId": null,
   "type": "instagram",
   "kind": "recipe",
   "details": {
    "ingredients": [
     "2 1/2 cups (313 g) all-purpose flour",
     "1 cup (200 g) granulated sugar",
     "2 tsp baking powder",
     "1 tsp ground cinnamon",
     "1/2 cup (115 g) unsalted butter, melted",
     "2 large eggs, room temperature",
     "3/4 cup (180 ml) whole milk",
     "2 medium apples, peeled and diced"
    ],
    "steps": [
     "Heat the oven to 350°F (177°C) and grease a 9x13-inch pan.",
     "Whisk the flour, sugar, baking powder and cinnamon, then stir in the butter, eggs and milk until just combined.",
     "Fold in the apples, spread the batter in the pan and swirl cinnamon sugar through the top.",
     "Bake 40 to 45 minutes until a toothpick comes out clean, cool 15 minutes, then drizzle with glaze."
    ],
    "yield": "12 slices",
    "totalMinutes": 70,
